Sub Process_Globals
	'These global variables will be declared once when the application starts.
	'These variables can be accessed from all modules.
	Private xui As XUI
	Private tmrSplash As Timer
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created.
	Private pnlSplash As Panel
	Private txtEmail As EditText
	Private txtPassword As EditText
	Private btnLogin As ACButton
	Dim cdTxt As ColorDrawable
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.LoadLayout("Login")
	If FirstTime Then
		ShowSplash
	End If
	tmrSplash.Initialize("DoSomething",300)
	tmrSplash.Enabled = True
	
	cdTxt.Initialize2(Colors.White, 0,0,Colors.Transparent)
	txtEmail.Background = cdTxt
	txtPassword.Background = cdTxt
	
	Misc.EnableButton(btnLogin)
	Misc.SetStatusBarAndNavigationColor(GlobalVar.PriColor)

End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Sub Activity_Touch (Action As Int, X As Float, Y As Float)
	StartActivity(MainScreen)
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean 'Return True to consume the event
	
End Sub

Sub Activity_PermissionResult (Permission As String, Result As Boolean)
	
End Sub

#Region Splash
Private Sub DoSomething_Tick
	Log("WORKING...")
End Sub

Private Sub ShowSplash
	pnlSplash.Visible = True
	Sleep(3000)
	pnlSplash.Visible = False
	tmrSplash.Enabled = False
End Sub

Private Sub pnlSplash_Touch (Action As Int, X As Float, Y As Float)
	
End Sub
#End Region

Sub btnLogin_Click
	
End Sub